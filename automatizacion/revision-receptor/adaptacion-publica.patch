+export function validateXlsxContainer(bytes){
+ // Cheap ZIP-directory check only. The existing Python normalizer is the sole
+ // schema/date/business validator; HTTP 202 never means inventory accepted.
+ const view=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength);
