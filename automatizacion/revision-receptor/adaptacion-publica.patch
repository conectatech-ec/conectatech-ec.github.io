+ for(let i=bytes.length-22;i>=Math.max(0,bytes.length-65557);i--)if(view.getUint32(i,true)===0x06054b50){end=i;break;}
+ if(end<0||view.getUint16(end+4,true)||view.getUint16(end+6,true)||end+22+view.getUint16(end+20,true)!==bytes.length)throw Error('XLSX_STRUCTURE');
+ const count=view.getUint16(end+10,true),size=view.getUint32(end+12,true),start=view.getUint32(end+16,true);
+ if(count<3||count>1000||view.getUint16(end+8,true)!==count||start+size!==end)throw Error('XLSX_STRUCTURE');
+ let at=start,total=0;const names=new Set();
+ for(let i=0;i<count;i++){
+  if(at+46>end||view.getUint32(at,true)!==0x02014b50)throw Error('XLSX_STRUCTURE');
+  const flags=view.getUint16(at+8,true),method=view.getUint16(at+10,true),nameLen=view.getUint16(at+28,true),extra=view.getUint16(at+30,true),comment=view.getUint16(at+32,true),local=view.getUint32(at+42,true);
+  if(at+46+nameLen+extra+comment>end||local+30>start||flags&1||![0,8].includes(method))throw Error('XLSX_STRUCTURE');
+  const name=new TextDecoder('utf-8',{fatal:true}).decode(bytes.subarray(at+46,at+46+nameLen));
+  if(names.has(name)||name.startsWith('/')||name.includes('..')||name.includes('\\')||name.includes('vbaProject')||name.includes('externalLinks/'))throw Error('UNSAFE_WORKBOOK');
+  if(view.getUint32(local,true)!==0x04034b50||local+30+view.getUint16(local+26,true)+view.getUint16(local+28,true)+view.getUint32(at+20,true)>start)throw Error('XLSX_STRUCTURE');
+  names.add(name);total+=view.getUint32(at+24,true);at+=46+nameLen+extra+comment;
+ }
+ if(at!==end||total>16000000||!['xl/workbook.xml','xl/worksheets/sheet1.xml','docProps/core.xml'].every(n=>names.has(n)))throw Error('XLSX_STRUCTURE');
+}
