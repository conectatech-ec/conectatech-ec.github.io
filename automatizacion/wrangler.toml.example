name = "conectatech-comercial-piloto"
main = "worker.mjs"
compatibility_date = "2026-10-01"
workers_dev = true
# Referencia alternativa; el despliegue aprobado usa deploy_free.py.
# Use Workers FREE only. Never upgrade automatically.
[vars]
LIVE_DATA = "true"
FREE_TIER_VERIFIED = "false"
[ai]
binding = "AI"
[[d1_databases]]
binding = "DB"
database_name = "conectatech-comercial-piloto"
database_id = "REPLACE_WITH_AUTHORIZED_FREE_D1_ID"
[triggers]
crons = ["19 * * * *"]
