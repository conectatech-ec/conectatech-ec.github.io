{
  "name": "conectatech-colaboradores-piloto",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"./public", "binding":"ASSETS", "run_worker_first":true},
  "vars": {"DEPLOYMENT_ENABLED":"false", "ACCESS_TEAM":"", "ACCESS_AUD":"", "PUBLIC_ORIGIN":"", "RETENTION_DAYS":"90"}
  // No D1 created or bound. Enable only after checking Free quotas and account plan.
  // d1_databases: [{binding:"DB",database_name:"...",database_id:"...",migrations_dir:"migrations"}]
  // Secrets through Wrangler: REFERRAL_SECRET (>=32 bytes), ALEX_SECRET (optional).
}
